{
  "compilerOptions": {
    "paths": {
      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@config/*": ["./src/config/*"],
      "@graphql/*": ["./src/graphql/*"],
      "@chaos/*": ["./src/chaos/*"]
    },
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Type safety —
       `strict` is the umbrella flag that turns on strictNullChecks,
       noImplicitAny, strictFunctionTypes, strictBindCallApply,
       strictPropertyInitialization, alwaysStrict, and
       useUnknownInCatchVariables. For a money app the headline one is
       strictNullChecks: it stops `null`/`undefined` from silently being
       members of every type, so a not-yet-loaded balance can't slip a
       runtime "Cannot read properties of undefined" into a balance view. */
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
